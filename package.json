{
  "name": "xiyou-programming-journey",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "XIYOU_E2E_STORAGE_FAULTS=1 vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:bundle-script && npm run test:assets",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update-evidence": "XIYOU_UPDATE_EVIDENCE=1 playwright test",
    "install:browsers": "playwright install chromium firefox webkit",
    "typecheck": "tsc --noEmit",
    "test:bundle-script": "node --test scripts/check-bundle-budget.test.mjs scripts/check-advanced-week-one-e2e-contract.test.mjs",
    "verify:bundle": "npm run test:bundle-script && npm run build && node scripts/check-bundle-budget.mjs",
    "test:assets": "node --test scripts/check-asset-manifest.test.mjs",
    "check:assets": "node scripts/check-asset-manifest.mjs",
    "verify:assets": "node scripts/check-asset-manifest.mjs --require-visual-qa"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.6",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "blockly": "^13.1.1",
    "phaser": "3.90.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.0.1",
    "sharp": "0.35.3",
    "typescript": "^5.9.3",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  }
}
